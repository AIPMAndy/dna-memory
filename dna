#!/usr/bin/env python3
"""
DNA Memory - 便捷入口
自动同步到 Claude Memory，真正让记忆生效
"""

import sys
import subprocess
from pathlib import Path

DNA_MEMORY_DIR = Path.home() / ".cc-switch/skills/dna-memory"
EVOLVE_SCRIPT = DNA_MEMORY_DIR / "scripts/evolve.py"
SYNC_SCRIPT = DNA_MEMORY_DIR / "scripts/sync_to_claude.py"

def main():
    if len(sys.argv) < 2:
        print("用法:")
        print("  dna remember <内容> [-t type] [-i importance]  # 记录并自动同步")
        print("  dna recall <关键词>                            # 搜索记忆")
        print("  dna sync                                       # 手动同步到 Claude")
        print("  dna stats                                      # 查看统计")
        print("  dna reflect                                    # 反思归纳")
        sys.exit(1)

    command = sys.argv[1]

    if command == "remember":
        # 记录记忆
        args = [str(EVOLVE_SCRIPT), "remember"] + sys.argv[2:]
        result = subprocess.run(["python3"] + args)

        if result.returncode == 0:
            print("\n🔄 自动同步到 Claude Memory...")
            sync_result = subprocess.run(["python3", str(SYNC_SCRIPT)])
            if sync_result.returncode == 0:
                print("\n✅ 记忆已生效！下次对话将自动应用。")

        sys.exit(result.returncode)

    elif command == "sync":
        # 手动同步
        args = [str(SYNC_SCRIPT)] + sys.argv[2:]
        result = subprocess.run(["python3"] + args)
        sys.exit(result.returncode)

    elif command in ["recall", "stats", "reflect", "promote", "dedupe"]:
        # 其他命令直接转发到 evolve.py
        args = [str(EVOLVE_SCRIPT), command] + sys.argv[2:]
        result = subprocess.run(["python3"] + args)
        sys.exit(result.returncode)

    else:
        print(f"❌ 未知命令: {command}")
        sys.exit(1)

if __name__ == "__main__":
    main()
